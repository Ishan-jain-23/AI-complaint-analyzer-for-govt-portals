<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/whitesmoke"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Stepper -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="64dp">
        <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/stepper_done" />
        <View android:layout_width="40dp" android:layout_height="2dp" android:background="@color/forest_green" />
        <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/stepper_active" />
        <View android:layout_width="40dp" android:layout_height="2dp" android:background="@color/light_gray" />
        <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/stepper_inactive" />
    </LinearLayout>

    <ProgressBar
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminateTint="@color/midnight_blue" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Analyzing your complaint…"
        android:textColor="@color/midnight_blue"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Our AI is detecting category, department and priority."
        android:gravity="center"
        android:layout_marginTop="8dp" />

</LinearLayout>